<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:focusable="true"
    android:clickable="true"
    android:background="@color/white"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:listPreferredItemHeight"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            app:srcCompat="@drawable/ic_card_black_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <Spinner
            android:id="@+id/spinner_payment_method"
            android:spinnerMode="dropdown"
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:listPreferredItemHeight"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            app:srcCompat="@drawable/ic_category_black_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:id="@+id/imageView2" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            style="@style/TextAppearance.AppCompat.Medium"
            android:spinnerMode="dropdown"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:listPreferredItemHeight"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            app:srcCompat="@drawable/ic_note_black_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <EditText
            android:id="@+id/add_expense_note"
            android:inputType="text"
            style="@style/add_expense_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_note_hint"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:layout_height="?android:listPreferredItemHeight">
        <ImageView
            app:srcCompat="@drawable/ic_calendar_black_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>

        <EditText
            android:id="@+id/add_expense_date"
            android:inputType="none"
            android:focusable="false"
            android:layout_weight="1"
            android:editable="false"
            style="@style/add_expense_text"
            android:text="@string/default_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <ImageView
            app:srcCompat="@drawable/ic_clock_black_24dp"
            android:layout_marginLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <EditText
            android:id="@+id/add_expense_time"
            android:inputType="none"
            android:layout_weight="1"
            android:focusable="false"
            android:editable="false"
            style="@style/add_expense_text"
            android:text="11:11PM"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>